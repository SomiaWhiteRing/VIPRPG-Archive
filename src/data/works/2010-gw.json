  {
    "id": "2010-gw-work-014",
    "festivalId": "2010-gw",
    "no": "014",
    "title": "さよならは一撃で",
    "author": "ざるそば",
    "source": {
      "url": "https://vipkohaku.x.fc2.com/2010GW/014.html",
      "snapshotUrl": "https://web.archive.org/web/20210710122528id_/https://vipkohaku.x.fc2.com/2010GW/014.html"
    },
    "download": {
      "url": "https://drive.google.com/open?id=1Q_7L5MxwW4cO3vV06Ko24oaoHjrPPtTy",
      "label": "ダウンドードする(1.21MB)"
    },
    "sourceContent": "<a href=\"/original-pages/2010-gw/013.html\">＜前の作品</a>　　　　　<a href=\"/original-pages/2010-gw/015.html\">次の作品＞</a>\n<div class=\"midashi\">No.014　さよならは一撃で</div>\n<div class=\"waku1\">\n\t<span class=\"archive-missing-image\">原資料の画像 01 は未取得です</span>\n\t<div class=\"waku2\">\n\t作者名：ざるそば\n\t</div>\n\t<div class=\"waku2\">\n\t●夢と希望に満ちたコメント<br>\n\t<br>\n「夢と希望……？<br>\n　そんなものは、ない」<br>\n悪夢ならば、在りうるけど。<br>\n<br>\nそんな訳でナイトメアバスターできませんで　した。<br>\n一直線ノベルです。キャラゲです。ホラーではないと思う。<br>\n臆すことなく趣味全開です。<br>\nぶっちゃけあんまりにもあんまりなので<br>\n他所でやれと言われそうな気がしないでもない。<br>\nふふふふｈ。<br>\n<br>\n「謎の失踪感」と評されたいつもの感じの<br>\nおまけも余裕があったら、ｔｋる予定です。<br>\n本編やってｳﾎﾞｧになった人へ。\t</div>\n\t<div class=\"waku2\">\n\t使用ツクール：2000\n\t</div>\n\t<div class=\"waku2\">\n\t<a href=\"https://drive.google.com/open?id=1Q_7L5MxwW4cO3vV06Ko24oaoHjrPPtTy\">ダウンドードする(1.21MB)</a>\n\t</div>\n\t<div class=\"waku2\">\n\t<a href=\"http://yy71.60.kg/test/read.cgi/gw2010k/1270118231/\">この作品の感想を書く</a>\n\t</div>\n\t<div class=\"waku2\">\n\t管理人コメント：退廃的な雰囲気のゲームは大好物ですまる\n\t</div>\n</div>\n<br>\n<a href=\"/original-pages/2010-gw/index.html\">BACK</a>\n\n<!-- FC2, inc.-->\n\n<!-- FC2, inc.-->"
  },
