  {
    "id": "2008-kouhaku-work-108",
    "festivalId": "2008-kouhaku",
    "no": "108",
    "title": "くらいところではちあわせ",
    "author": "",
    "ss": [
      "/screenshots/2008-kouhaku/108.png"
    ],
    "source": {
      "url": "https://vipkohaku.x.fc2.com/2008/sakuhin_108.html",
      "snapshotUrl": "https://web.archive.org/web/20210803110517id_/https://vipkohaku.x.fc2.com/2008/sakuhin_108.html"
    },
    "sourceContent": "<table>\n\t\t\t<tbody><tr><td class=\"number\">No.108</td>\n\t\t\t\t<td class=\"title\">くらいところではちあわせ</td></tr>\n\t\t\t<tr><td colspan=\"2\"></td></tr>\n\n\t\t\t<tr><td class=\"red\">作者名</td>\n\t\t\t\t<td class=\"white\">リンサン</td></tr>\n\n\t\t\t<tr><td class=\"red\">作者コメント</td><td class=\"white\">\n\nどんどん暗くなるダンジョンを冒険するデフォ戦RPG。<br>\n年の瀬のヒマつぶし、大作の合間の息抜き、<br>\n炊飯器に入れたご飯が炊けるまでの空いた時間なんかにでも遊んでくれるとうれしいです。\n\n\n\t\t\t</td></tr>\n\t\t\t<tr><td class=\"red\">管理者コメント</td><td class=\"white\">\n\nんん！？これは何か良さ気な感じだ！<br>\n一瞬自作っぽく見えたのは何故？\n\n\t</td></tr>\n\t<tr><td class=\"red\">\n\t\t\t★削除しました。★\n\n\t</td><td class=\"white\">\n\t\t\t2000製---1.5MB\n\n\t</td></tr>\n\n\t<tr><td class=\"red\" colspan=\"2\">\n\t\t\t<a href=\"http://yy66.60.kg/test/read.cgi/kansou2008/1228894361/\">感想掲示板</a>\n\t</td></tr>\n\t\n<!-- FC2, inc.-->\n\n<!-- FC2, inc.-->\n\n\n</tbody></table>",
    "group": "白組"
  },
