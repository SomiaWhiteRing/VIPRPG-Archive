  {
    "id": "2008-kouhaku-work-106",
    "festivalId": "2008-kouhaku",
    "no": "106",
    "title": "ゆうしゃのあるいちにち",
    "author": "",
    "ss": [
      "/screenshots/2008-kouhaku/106.png"
    ],
    "source": {
      "url": "https://vipkohaku.x.fc2.com/2008/sakuhin_106.html",
      "snapshotUrl": "https://web.archive.org/web/20210803110526id_/https://vipkohaku.x.fc2.com/2008/sakuhin_106.html"
    },
    "sourceContent": "<table>\n\t\t\t<tbody><tr><td class=\"number\">No.106</td>\n\t\t\t\t<td class=\"title\">ゆうしゃのあるいちにち</td></tr>\n\t\t\t<tr><td colspan=\"2\"></td></tr>\n\n\t\t\t<tr><td class=\"red\">作者名</td>\n\t\t\t\t<td class=\"white\">ざるそば</td></tr>\n\n\t\t\t<tr><td class=\"red\">作者コメント</td><td class=\"white\">\n\n～だーくりすます中止のお知らせ～<br>\n<br>\n2008年12月25日に公開予定のだーくりすますは<br>\n諸事情により中止になりました。<br>\n中止、ならびに本告知が遅れたことにつきまして、<br>\n楽しみにしておられた方々、及び関係者各位には謹んでお詫び申し上げます<br>\n<br>\n※この時間帯は代わりに<br>\n「ゆうしゃのあるいちにち」を<br>\nお送りいたします。\n\n\n\n\t\t\t</td></tr>\n\t\t\t<tr><td class=\"red\">管理者コメント</td><td class=\"white\">\n\nだーこう乙。\n\n\t</td></tr>\n\t<tr><td class=\"red\">\n\t\t\t<a href=\"https://ux.getuploader.com/2008kouhakukari/download/67\">ダウンロード</a>\n\n\t</td><td class=\"white\">\n\t\t\t2000製---0.8MB\n\n\t</td></tr>\n\n\t<tr><td class=\"red\" colspan=\"2\">\n\t\t\t<a href=\"http://yy66.60.kg/test/read.cgi/kansou2008/1228706801/\">感想掲示板</a>\n\t</td></tr>\n\t\n<!-- FC2, inc.-->\n\n<!-- FC2, inc.-->\n\n\n</tbody></table>",
    "group": "白組"
  },
