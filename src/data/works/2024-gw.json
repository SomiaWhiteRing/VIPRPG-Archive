  {
    "id": "2024-gw-work-25",
    "festivalId": "2024-gw",
    "no": "25",
    "title": "もしもゆびをふるバトルだったら",
    "author": "雨水葉月",
    "category": "やるゲ",
    "engine": "VXAce",
    "streaming": "○/○",
    "source": {
