				var linkurl = alllinks[i].getAttribute("href");
				if(!linkurl.indexOf("https://img.shitaraba.net/")) {
					var source = '<img class="lazyload pc_res_image_lazy" data-src="' +  linkurl +'" />';
					alllinks[i].innerHTML = source;
