		var i;
		var view=0;
		var iMax = aSplit2.length;
		// &で分割した物を = で分割
		for( i = 0; i< iMax; i++ ){
			aSplit3 = aSplit2[i].split("=");
			if (aSplit3[0]=="view"){
				view=aSplit3[1];
			}
		}
	}

