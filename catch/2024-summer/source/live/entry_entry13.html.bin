			var pageName = "溺死するＲＰＧ";
			var gameNo   = "13";
		</script>
        <!--↑gameName=のダブルクォーテーション内にゲーム名、gameNo=のダブルクォーテーション内に作品Noを入力してください-->
	</head>
	<body class="sky">
		<define id="HEADER"></define>
		<define id="PAGENAME"></define>
