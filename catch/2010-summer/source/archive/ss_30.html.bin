<BODY link="#ffffff" vlink="#666666">
<CENTER>
<TABLE border="0">
  <TBODY>
    <TR>
      <TD align="left" height="17" width="181"><A href="ss_29.html"><B><FONT color="#ffffff"><IMG src="text02.png" width="80" height="20" border="0"></FONT></B></A></TD>
      <TD height="17" width="163" align="right"><B><FONT color="#ffffff"><A href="ss_31.html"><IMG src="text03.png" width="80" height="20" border="0"></A></FONT></B></TD>
