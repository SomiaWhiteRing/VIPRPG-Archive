<tr align="center"><td colspan="2"><img src="./SS/No04SS1.png" onmouseover="this.src='./SS/No04SS2.png';" onmouseout="this.src='./SS/No04SS1.png';"></td>
<tr><td colspan="32"><font size="5">【作者】徳明</font></td>
<tr><td colspan="32"><font size="4">【得点】合計：336pt</font>　(＋SS：27pt)<br />
