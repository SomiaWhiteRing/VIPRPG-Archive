/*####ページ全体の記述####################################################################################################*/html {color: #0000CC; height: 100%;font-size: 14px;}H1 {font-size: 120%;}H2 {font-size: 110%;}H3 {font-size: 100%;}H4 {font-size: 100%;}H5 {font-size: 90%;}H6 {font-size: 80%;}div.hidari {text-align: left;float:left;width: 100px;}div.naka {text-align: center;float:left;width: 452px;}div.migi {text-align: right;float:left;width: 100px;}img {border: none;}a:link { color: #CC0066; }a:visited { color: #CC0066; }a:hover { color:#FFFF00; }a:active { color: #FF3300; }span.aa {font-family: "ＭＳ Ｐゴシック";font-size: 12pt;font-style: normal;font-variant: normal;font-weight: normal;line-height: 100%;white-space: nowrap;}/*####ボディの設定####################################################################################################*/#body1 {scrollbar-base-color: #FFFF00;background-color: #42C3F5;background-image: url(backcolor.png);}#mannaka {margin: 0px auto;padding: 0px;height: auto;width: 652px;text-align: left;}div.namae{background-color: #42C3F5;width: 648px;height: 25px;border: 2px #87CEFA outset;text-align: center; line-height: 25px; float:left; font-weight: bold;}img.ss {border: 6px  #0000CC ridge;}#table1 {width: 652px;border: 1px white solid;font-size: 90%; }  #th1 {border: 1px white solid;padding: 3px;}#td2 {border: 1px white solid;background-color:#FFFFFF;}iframe.bbs {height: 650px;width:650px;border: 1px #ffffff inset;float:left;}span.no4{margin-left: 320px;font-size: 50%;}div.nisen{color: #ffffff;background-color:#3366FF;width: 648px;height: 25px;text-align: center; line-height: 25px; float:left; font-weight: bold;border: 2px #33CCFF outset;}div.nisensan{color: #ffffff;background-color:#FF3333;width: 648px;height: 25px;text-align: center; line-height: 25px; float:left; font-weight: bold;border: 2px #FF6699 outset;}div.xp{color: #ffffff;background-color:#FF9933;width: 648px;height: 25px;text-align: center; line-height: 25px; float:left; font-weight: bold;border: 2px #FFFF99 outset;}div.vx{color: #ffffff;background-color:#708090;width: 648px;height: 25px;text-align: center; line-height: 25px; float:left; font-weight: bold;border: 2px #DCDCDC outset;}div.srpg{color: #ffffff;background-color:#3CB371;width:  648px;height: 25px;text-align: center; line-height: 25px; float:left; font-weight: bold;border: 2px #98FB98 outset;}