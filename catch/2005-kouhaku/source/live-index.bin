<!DOCTYPE html>
<html lang="ja">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>land.to サービス終了のお知らせ</title>

  <style>
    :root {
      --main-red: #e04a4a;
      --text-color: #333;
      --gray-bg: #f3f3f3;
      --line-color: #e6e6e6;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Hiragino Kaku Gothic ProN",
        "Noto Sans JP", "Yu Gothic", Meiryo, sans-serif;
      color: var(--text-color);
      background: #ffffff;
      line-height: 1.9;
    }

    .container {
      max-width: 710px;
      margin: 0 auto;
      padding: 40px 10px 0;
    }

    /* ロゴ */
    .logo {
      text-align: center;
      margin-bottom: 30px;
      color: var(--main-red);
      font-weight: bold;
    }

    /* 見出し */
    h1 {
      text-align: center;
      font-weight: bold;
    }

    h1 {
      font-size: 22px;
      margin: 60px 0 10px;
    }

    .heading-underline {
      position: relative;
      text-align: center;
      font-size: 24px;
      margin: 60px 0 25px;
    }

    .heading-underline::after {
      content: "";
      display: block;
      width: 100%;
      height: 1px;
      background: var(--main-red);
      margin: 0;
    }

    p {
      font-size: 16px;
      margin: 0 0 20px;
    }

    .notice-text {
      font-weight: 700;
    }

    .highlight {
      color: var(--main-red);
      font-weight: bold;
    }

    /* 誘導セクション */

    .logo-wrap svg {
      display: block;
      width: 100%;
      height: auto;
    }

    .responsive-svg {
      display: block;
      width: 100%;
      max-width: 480px;
      height: auto;
      margin: 0 auto;
    }

    .link-section {
      margin-top: 40px;
    }

    .link-title {
      text-align: center;
      font-weight: bold;
      margin: 40px 0 12px;
      font-size: 15px;
    }

    .link-box {
      max-width: 500px;
      margin: auto;
      background: var(--gray-bg);
      padding: 18px 20px;
      border-radius: 4px;
      display: flex;
      align-items: center;
      justify-content: space-evenly;
      gap: 14px;
      cursor: pointer;
      transition: background 0.2s ease;
      border: 1px solid #ddd;
    }

    .link-box:hover {
      background: #ececec;
    }

    .icon {
      color: var(--main-red);
      font-size: 22px;
      font-weight: bold;
    }

    footer {
      text-align: center;
      font-size: 12px;
      color: #999;
      margin: 150px 0 10px 0;
    }

    /* レスポンシブ */
    @media (max-width: 600px) {
      h1 {
        font-size: 20px;
      }

      h2 {
        font-size: 18px;
      }

      .link-box {
        flex-direction: column;
        text-align: center;
      }

      .icon {
        font-size: 26px;
      }
    }
  </style>
</head>

<body>

  <div class="container">

    <!-- ロゴ -->
