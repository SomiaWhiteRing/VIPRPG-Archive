  const bgObserver = new IntersectionObserver((entries, _) => {
    for (const entry of entries) {
      if (entry.isIntersecting) {
        entry.target.style.backgroundImage = `url("${entry.target.dataset.src}")`;
        entry.target.style.opacity = "1";
        entry.target.style.animation = ["fadein", ".25s", "ease-out"].join(" ");
        bgObserver.unobserve(entry.target);
      }
    }
  });

  for (const card of document.querySelectorAll(".entry-card"))
    bgObserver.observe(card);
</script><meta name=viewport content="width=device-width,initial-scale=1"><script type=module>
