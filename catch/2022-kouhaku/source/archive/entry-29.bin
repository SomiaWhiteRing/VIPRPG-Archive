  </script><link rel=stylesheet href=/assets/style.css><link rel=canonical href=https://viprpg2022kohaku.x.2nt.com/entries/29/><meta property="og:url" content="https://viprpg2022kohaku.x.2nt.com/entries/29/"><meta property="og:site_name" content="VIPRPG紅白 2022"><meta property="twitter:card" content="summary_large_image"><meta property="og:description" name=description content="VIPRPG紅白 2022 エントリーNo. 29"><meta property="og:title" content="霧の森の魔女/陽だまりの教会"><meta property="og:image" content="https://viprpg2022kohaku.x.2nt.com/entries/29/screenshots/main.webp"><meta property="og:locale" content="ja_JP"><meta property="og:type" content="website"></head><body><div class=wrapper-global><header class=header-pc><nav><h1 class=nav-item><a href=/>VIPRPG紅白 2022</a></h1><h2 hidden>メニュー</h2><p class="nav-item button-arena"><strong><a href=/entries/>募集中</a></strong></p><ul class="nav-item nav-subs"><li><a href=/about/>各種要綱</a></li><li><a href=/vote/>投票</a></li><li><a href=/news/>お知らせ</a></li><li><a href=https://jbbs.shitaraba.net/otaku/18266/>感想掲示板</a></li></ul></nav></header><header class=header-mobile><h1><a href=/>VIPRPG紅白 2022</a></h1><div class=menu-mobile><input type=checkbox id=menu-opener name=menu-opener value=off>
