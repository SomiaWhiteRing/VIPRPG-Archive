<script src="../js/jquery.js"></script>
<script src="../js/jquery.cookie.js"></script>
<script src="../js/jquery.sticky.js"></script>
<script src="../js/common.js"></script>
<script type="text/JavaScript"><!--

    //メニュー付いてくる/*
    $(document).ready(function(){
      $("#stickmenu").sticky({ topSpacing: 0, center:true,});
    });

    //読み込み
    readResult();
    function readResult(){
        $.when(
            $.getJSON('../games/data.json'),
            $.getJSON('23_analysis1.php'),
        )
        .done(function(data, vote){       
            var num = data[0]['num']; //作品数
            
			//ポップリストの生成
			var listText = '<ul>';
			for(var j = 0; j <= num; j++){
				listText += '<li value="' + j + '" id="glist' + j + '">' + data[0][j]['title'] + '</li>';
			}
			listText += '</ul>';
			$('#popList').html(listText);	


            for(var i = 0; i <= 9; i++){
                //作品
                var str = '<table class="gamelist">';
                    str += '<tr>';
                        str += '<td>No.</td>';
                        str += '<td>日時</td>';
                        str += '<td>年齢</td>';
                        str += '<td>性別</td>';
                        str += '<td>得点</td>';
                        str += '<td>累計人数</td>';
                        str += '<td>累計得点</td>';
                    str += '</tr>';

                for(var j = 0; j <= vote[0][i].length - 1; j++){
                    //作品名とそのリンク
                    var gn = Number(vote[0][i][j][0]);
                    str += '<tr name="game' + gn + '">';
                        str += '<td>' + gn + '</td>';
                        str += '<td>' + vote[0][i][j][1] + '</td>';
                        str += '<td>' + vote[0][i][j][2] + '</td>';
                        str += '<td>' + vote[0][i][j][3] + '</td>';
                        str += '<td>' + vote[0][i][j][4] + '</td>';
                        str += '<td>' + vote[0][i][j][5] + '</td>';
                        str += '<td>' + vote[0][i][j][6] + '</td>';
                    str += '</tr>';
                }
                str += '</table>';
                $('#vote' + i).html(str);
                //重すぎるから初期は非表示
                $('[name^="game"]').hide();
            }


			
        });
    }

	//作品から絞り込む
	$('[id^="gameList"]').on({
		//マウスオン
		'mouseenter': function(){
			$('#popList').show();
			$('#popList').insertAfter(this);
			//要素内移動
			var position = $('#popList li').eq(idGet()).position().top;
			$('#popList').scrollTop(position);

		},
		//マウスオフ
		'mouseleave': function(){
			$('#popList').hide();
		},
	});
	$('#popList').on({
		//マウスオン
		'mouseenter': function(){
			$(this).show();
		},
		//マウスオフ
		'mouseleave': function(){
			$(this).hide();
		},
	});
	//POPLISTの挙動
	$('body').on({
		//クリック
		'click': function(){
			//データ読み込み、画面更新
			var viewgn = $(this).index();
			var viewgt = $(this).text();
			//$('#popList ').prop('selected');
			//値変更
			$('#viewgn').text(viewgn);
			$('#viewgt').text(viewgt);
			//表示変更
			$('[name^="game"]').hide();
			$('[name="game' + viewgn + '"]').show();

		},
	},'#popList li');

	$('#gameAll').on('click', function(){
		$('[name^="game"]').show();
		$('#viewgn').text('');
		$('#viewgt').text('');
	});

	//次へと前へ
	$('#before').on('click', function(){
		//現在の番号取得
		var now = Number($('#viewgn').text());
		//無表示または0以外なら処理
		if(now !="" & now != 0){
			var newnum = now - 1;
			//値変更
			$('#viewgn').text(newnum);
			//作品名取得
			var title = $('#glist' + newnum).text();
			$('#viewgt').text(title);
			//表示変更
			$('[name^="game"]').hide();
			$('[name="game' + newnum + '"]').show();
		}
	});
	$('#next').on('click', function(){
		//現在の番号取得
		var now = Number($('#viewgn').text());
		//無表示または0以外なら処理
		if(now !="" & now != 70){
			var newnum = now + 1;
			//値変更
			$('#viewgn').text(newnum);
			//作品名取得
			var title = $('#glist' + newnum).text();
			$('#viewgt').text(title);
			//表示変更
			$('[name^="game"]').hide();
			$('[name="game' + newnum + '"]').show();
		}
	});

    //ジャンプ
    $('[id^="jump"]').on('click', function(){
        var num = $(this).attr('id')[4];
        var target = $('#vote' + num);
        // 移動先を数値で取得
        var position = target.offset().top;
        // スムーススクロール
        $('html, body').animate({scrollTop:position}, 400, 'swing');
    });

	$(function(){
		// #で始まるアンカーをクリックした場合に処理
		$('a[href^="#"]').on('click', function(){
			// スクロールの速度
			var speed = 400; // ミリ秒
			// アンカーの値取得
			var href= $(this).attr("href");
			// 移動先を取得
			var target = $(href == "#" || href == "" ? 'html' : href);
			// 移動先を数値で取得
			var position = target.offset().top;
			// スムーススクロール
			$('html, body').animate({scrollTop:position}, speed, 'swing');
			return false;
		});
	});

--></script>
<script type="module" src="https://static.cloudflareinsights.com/beacon.min.js/vce701823e78c4301a35b7e07294d87301792088814092" integrity="sha512-UKNk8GbxkABxKcXYuLkO16EleLGUkcvJWtpSNmExE0Too3ZaFAxTscNWEc1OdAv5/BikHawapSCaiD2XCmp+Bw==" data-cf-beacon='{"version":"2024.11.0","token":"1b464aad4cb14e2ea25b2030f823e83c","spa":2}' crossorigin="anonymous"></script>
