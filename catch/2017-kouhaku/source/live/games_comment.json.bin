u3089\u30d7\u30ec\u30a4\u3057\u307e\u3057\u305f\u3002\u60aa\u9b54\u3084\u5929\u4f7f\u306f\u30e6\u30fc\u30e2\u30e9\u30b9\u304b\u3064\u60e8\u9177\u3067\u3069\u3053\u304b\u611b\u5b0c\u304c\u3042\u308a\u3001\u4eba\u9593\u306f\u6642\u306b\u89e6\u308c\u5408\u3063\u3066\u306f\u96e2\u308c\u3001\u305d\u308c\u305e\u308c\u306e\u9053\u3092\u5f81\u304f\u59ff\u304c\u5bc2\u3057\u304f\u3082\u3042\u308a\u6c17\u9ad8\u304f\u3082\u3042\u308a\u2026\u8907\u96d1\u3067\u3059\u304c\u3001\u4f55\u3082\u304b\u3082\u304c\u300c\u597d\u304d\u300d\u3068\u601d\u3048\u308b\u7269\u8a9e\u3067\u3042\u308a\u307e\u3057\u305f\u3002<br \/>\n<br \/>\n\u30e1\u30ac\u30c6\u30f3\u306f\u4eca\u56de\u521d\u3081\u3066\u89e6\u308b\u30b8\u30e3\u30f3\u30eb\u3060\u3063\u305f\u306e\u3067\u3059\u304c\u3001UI\u306e\u512a\u79c0\u3055\u3068\u75d2\u3044\u6240\u306b\u624b\u304c\u5c4a\u304f\u30b9\u30c6\u30fc\u30b8\u30ae\u30df\u30c3\u30af\u3001\u60aa\u9b54\u5408\u4f53\u306e\u624b\u8efd\u3055\u3068\u30c6\u30af\u30cb\u30ab\u30eb\u3055\u306b\u6c17\u3065\u3044\u305f\u3089\u306e\u3081\u308a\u8fbc\u3093\u3067\u3044\u307e\u3057\u305f\u3002<br \/>\n\u88c5\u5099\u3082\u6b74\u4ee3\u30b2\u30fc\u30e0\u306e\u4e2d\u3067\u306f\u5c11\u306a\u3044\u65b9\u3067\u3059\u304c\u591a\u5f69\u3067\u3001\u5012\u3055\u308c\u3066\u306f\u4f55\u304c\u3042\u308c\u3070\u3088\u3044\u306e\u304b\u3068\u8a66\u884c\u932f\u8aa4\u3055\u305b\u3089\u308c\u308b\u3001\u30ec\u30d9\u30eb\u3092\u4e0a\u3052\u305f\u3060\u3051\u3067\u306f\u4f55\u3068\u304b\u306a\u3089\u306a\u3044\u7d76\u5999\u306a\u30d0\u30e9\u30f3\u30b9\u304c\u6700\u9ad8\u3067\u3057\u305f\u3002<br \/>\n<br \/>\n\u30b9\u30c8\u30fc\u30ea\u30fc\u304c\u9032\u3080\u307b\u3069\u306b\u73fe\u308c\u308b\u30ed\u30fc\u30bc\u30f3\u30af\u30ed\u30a4\u30c4\u7bc0\u3001\u305d\u3057\u3066\u5fb9\u982d\u5fb9\u5c3e\u8cab\u304b\u308c\u308b\u300c\u4eba\u306e\u4fa1\u5024\u3068\u306f\u4f55\u305e\u3084\u300d\u3068\u3044\u3046\u547d\u984c\u306b\u9b45\u4e86\u3055\u305b\u3089\u308c\u3063\u3071\u306a\u3057\u3067\u3059\u3002\u7b46\u3092\u304a\u3044\u305f\u3089\u3001\u307e\u305f\u4e8c\u5468\u4e09\u5468\u3068\u898b\u5c4a\u3051\u7d9a\u3051\u305f\u3044\u3068\u601d\u3044\u307e\u3059\u3002<br \/>\n\u4eca\u56de\u3082\u7d20\u6674\u3089\u3057\u3044\u4f5c\u54c1\u306b\u89e6\u308c\u3055\u305b\u3066\u3044\u305f\u3060\u304d\u307e\u3057\u305f\uff01\u6b21\u56de\u4f5c\u3082\u697d\u3057\u307f\u306b\u3057\u3066\u304a\u308a\u307e\u3059\u2026\u304c\u3001\u4eca\u306f\u304a\u75b2\u308c\u3055\u307e\u3001\u3068\u8a00\u308f\u305b\u3066\u3044\u305f\u3060\u304d\u307e\u3059\u3002\u3042\u308a\u304c\u3068\u3046\u3054\u3056\u3044\u307e\u3057\u305f\uff01"],[41,"2018-01-08","\u7121\u56de\u7b54","\u7537\u6027","\u30b5\u30a4\u30b3\u30fc( ^\u03c9^ )"],[41,"2018-01-08","20\u4ee3","\u7537\u6027","\u307e\u3060\u4e00\u56de\u30af\u30ea\u30a2\u3067\u3059\u304c\u3001\u78ba\u4fe1\u7684\u306bKAETTA\u3057\u307e\u3057\u305f<br \/>\n\u76f8\u5909\u308f\u3089\u305a\u5168\u4f53\u306e\u96f0\u56f2\u6c17\u304c\u25cb<br \/>\n<br \/>\n\u60aa\u9b54\u3068\u306e\u4ea4\u6e09\u306e\u30d0\u30ea\u30a8\u30fc\u30b7\u30e7\u30f3\u306e\u591a\u3055\u306b\u3073\u3063\u304f\u308a"],[41,"2018-01-08","30\u4ee3","\u7537\u6027","\u306b\u3083\u30fc\u3093"],[41,"2018-01-09","30\u4ee3","\u7537\u6027","\u30ce\u30af\u30bf\u30fc\u30f3\u306f\u7279\u306b\u5370\u8c61\u306b\u6b8b\u308b\u4f5c\u54c1\u3060\u3063\u305f\u306e\u3067\u3001\u968f\u6240\u306b\u6563\u308a\u3070\u3081\u3089\u308c\u305f\u539f\u4f5c\u611b\u3084\u30ea\u30b9\u30da\u30af\u30c8\u304c\u3068\u306b\u304b\u304f\u6700\u9ad8\u3067\u3057\u305f\u306d\u3002\u3000\u4e00\u5468\u76ee\u3092\u30e8\u30b9\u30ac\u30eb\u30fc\u30c8\u3067\u7d42\u3048\u3066\u601d\u3063\u305f\u306e\u306f\u3001\u4eca\u56de\u306e\u796d\u308a\u4f5c\u54c1\u3001\u305d\u3057\u3066\u3053\u308c\u307e\u3067\u30d7\u30ec\u30a4\u3057\u3066\u304d\u305f\u30e1\u30ac\u30c6\u30f3\u306e\u30aa\u30de\u30fc\u30b8\u30e5\u4f5c\u54c1\u306e\u4e2d\u3067\u3001\u9593\u9055\u3044\u306a\u304f\u30c0\u30f3\u30c8\u30c4\u306e\u51fa\u6765\u3060\u3063\u305f\u3068\u3044\u3046\u3053\u3068\u3067\u3059\u3002\u3000\u30b9\u30c8\u30fc\u30ea\u30fc\u3084\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u500b\u6027\u3001\u30c0\u30f3\u30b8\u30e7\u30f3\u306e\u30ae\u30df\u30c3\u30af\u3001\u305d\u3057\u3066\u30e1\u30ac\u30c6\u30f3\u3067\u6b20\u304b\u3059\u3053\u3068\u306e\u51fa\u6765\u306a\u3044\u5408\u4f53\u30b7\u30b9\u30c6\u30e0\u306a\u3069\u3001\u3069\u3053\u3092\u5207\u3063\u3066\u3082\u300c\u826f\u304b\u3063\u305f\u3088\u306a\u3041\u300d\u3068\u8a00\u3048\u308b\u4e00\u54c1\u3067\u3057\u305f\u3002\u3000\u4e8c\u5468\u76ee\u306f\u30ec\u30a4\u30ed\u30eb\u30fc\u30c8\u3092\u653b\u7565\u4e88\u5b9a\u3067\u3059\u304c\u3001\u5fc5\u305a\u5468\u56de\u3057\u3066\u5168\u3066\u306e\u30a8\u30f3\u30c7\u30a3\u30f3\u30b0\u3068\u30c8\u30ed\u30d5\u30a3\u30fc\u3092\u56de\u53ce\u3057\u3066\u3084\u308d\u3046\u3068\u601d\u3044\u307e\u3059\u3002"],[41,"2018-01-10","20\u4ee3","\u305d\u306e\u4ed6","\u5973\u795e\u8ee2\u751f\u306e\u30d1\u30ed\u30c7\u30a3\u4f5c\u54c1\u3002\u5c71\u5f62\u3092\u821e\u53f0\u306b\u3057\u305f\u3053\u3068\u3068\u3001AA\u3092\u30e2\u30c1\u30fc\u30d5\u306b\u3057\u305f\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u767b\u5834\u3055\u305b\u305f\u3053\u3068\u3067\u3001\u5358\u306a\u308b\u30d1\u30ed\u30c7\u30a3\u306b\u3068\u3069\u307e\u3089\u306a\u3044\u30b2\u30f1\u30e0\u306b\u4ed5\u4e0a\u304c\u3063\u3066\u3044\u308b\u3002<br \/>\n\u7f8e\u9e97\u304b\u3064\u7dfb\u5bc6\u306a\u30c9\u30c3\u30c8\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u3001\u72ec\u7279\u3067\u6642\u306b\u306f\u904e\u6fc0\u306a\u8a00\u3044\u56de\u3057\u3001\u60aa\u9b54\u5408\u4f53\u306e\u697d\u3057\u3055\u3001\u7684\u78ba\u306aBGM\u9078\u3073\u3001\u73fe\u5b9f\u4e16\u754c\u306e\u5199\u771f\u3092\u53d6\u308a\u5165\u308c\u305f\u9060\u666f\u8868\u73fe\u3001\u9069\u5ea6\u306a\u6b6f\u3054\u305f\u3048\u306e\u3042\u308b\u6226\u95d8\u3001\u30c0\u30f3\u30b8\u30e7\u30f3\u5404\u5730\u306b\u8a2d\u7f6e\u3055\u308c\u305f\u30b7\u30e7\u30fc\u30c8\u30ab\u30c3\u30c8\u3001\u60a9\u307f\u8ff7\u3044\u306a\u304c\u3089\u6210\u9577\u3057\u3066\u3044\u304f\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3001\u8c4a\u5bcc\u306a\u30de\u30eb\u30c1\u30a8\u30f3\u30c9\u3001\u4f5c\u8005\u3055\u3093\u306e\u904e\u53bb\u4f5c\u3092\u77e5\u3063\u3066\u3044\u308b\u3068\u3046\u308c\u3057\u3044\u30d5\u30a1\u30f3\u30b5\u30fc\u30d3\u30b9\u306a\u3069\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u30b9\u30c8\u30ec\u30b9\u3092\u4e0e\u3048\u3059\u304e\u305a\u3001\u305d\u3057\u3066\u98fd\u304d\u3055\u305b\u306a\u3044\u4f5c\u308a\u306b\u306a\u3063\u3066\u3044\u308b\u3002<br \/>\n\u79c1\u306f\u5973\u795e\u8ee2\u751f\u30b7\u30ea\u30fc\u30ba\u3092\u904a\u3093\u3060\u3053\u3068\u306f\u306a\u3044\u304c\u3001\u975e\u5e38\u306b\u697d\u3057\u3081\u305f\u3002\u65e2\u30d7\u30ec\u30a4\u306e\u4eba\u306f\u7d30\u304b\u3044\u30cd\u30bf\u3092\u62fe\u3048\u3066\u3082\u3063\u3068\u697d\u3057\u3081\u305d\u3046\u3002\u5973\u795e\u8ee2\u751f\u30b7\u30ea\u30fc\u30ba\u306f\u96e3\u6613\u5ea6\u304c\u9ad8\u3044\u3068\u3044\u3046\u30a4\u30e1\u30fc\u30b8\u304c\u3042\u3063\u305f\u304c\u3001\u3053\u3061\u3089\u306f\u3060\u3044\u3076\u30de\u30a4\u30eb\u30c9\u306b\u306a\u3063\u3066\u3044\u308b\u3088\u3046\u306a\u306e\u3067\u3001\u9ad8\u96e3\u6613\u5ea6\u30b2\u30fc\u304c\u82e6\u624b\u306a\u4eba\u306b\u3082\u304a\u52e7\u3081\u3067\u304d\u308b\u30b2\u30f1\u30e0\u3002\u63a7\u3048\u3081\u306b\u8a00\u3063\u3066\u5091\u4f5c\u3002"],[41,"2018-01-13","20\u4ee3","\u5973\u6027","\u30b2\u30fc\u30e0\u82e6\u624b\u3067\u3082\u98fd\u304d\u305a\u306b\u7121\u4e8b\u306b\u30c8\u30ed\u30b3\u30f3\u3067\u304d\u307e\u3057\u305f\u3002\u697d\u3057\u304b\u3063\u305f\u3067\u3059\u3002\u6b21\u56de\u4f5c\u3082\u697d\u3057\u307f\u3067\u3059\u3002"],[41,"2018-01-14","20\u4ee3","\u7537\u6027","\u904a\u3073\u3084\u3059\u304f\u3001\u304b\u3064\u6b6f\u3054\u305f\u3048\u306e\u3042\u308b\u4e2d\u7de8RPG\u3002"],[41,"2018-01-15","20\u4ee3","\u7537\u6027","\u81ea\u5206\u306f\u5973\u795e\u8ee2\u751f\u306e\u7d76\u671b\u7684\u306a\u96f0\u56f2\u6c17\u304c\u597d\u304d\u3067\u3001\u3053\u308c\u3092PIAI\u3057\u3066\u898b\u307e\u3057\u305f\u3002\u305b\u3063\u304b\u304f\u751f\u304d\u6b8b\u3063\u305f\u751f\u5f92\u304c\u5f90\u3005\u306b\u72c2\u3063\u3066\u3044\u304f\u69d8\u304c\u3068\u3063\u3066\u3082\u826f\u304b\u3063\u305f\u3067\u3059\u3002<br \/>\n\u97f3\u697d\u306f\u3068\u3066\u3082\u7d20\u6575\u3067\u3001\u6226\u95d8BGM\u306f\u30c6\u30f3\u30b7\u30e7\u30f3\u304c\u4e0a\u304c\u308a\u307e\u3059\u3002\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u3082\u7d20\u6674\u3089\u3057\u304f\u8868\u60c5\u304c\u3088\u304f\u5909\u308f\u3063\u305f\u308a\u3001AA\u3092\u3046\u307e\u304f\u60aa\u9b54\u306e\u30c7\u30b6\u30a4\u30f3\u306b\u843d\u3068\u3057\u3053\u3093\u3067\u3044\u307e\u3057\u305f\u3002\uff76\uff70\uff81\uff6c\uff9d\u306f\u6700\u521d\u304b\u3089\u6700\u5f8c\u307e\u3067\u4e3b\u4eba\u516c\u3092\u898b\u5b88\u3063\u3066\u304f\u308c\u3066\u7d76\u671b\u7684\u306a\u96f0\u56f2\u6c17\u306e\u4e2d\u306e\u7652\u3057\u3067\u3057\u305f\u3002\u5468\u56de\u3084\u30c8\u30ed\u30d5\u30a3\u30fc\u307e\u3067\u5b9f\u88c5\u3055\u308c\u3066\u3044\u3066\u9577\u3044\u6642\u9593\u697d\u3057\u3081\u307e\u3057\u305f\u3002\u30b9\u30c8\u30fc\u30ea\u30fc\u30823\u306f\u904a\u3093\u3060\u3053\u3068\u304c\u3042\u308a\u307e\u305b\u3093\u304c\u3001\u3068\u3066\u3082\u697d\u3057\u3093\u3067PIAI\u3067\u304d\u307e\u3057\u305f\u3002"],[41,"2018-01-15","30\u4ee3","\u5973\u6027","2011\u306e\u521d\u53c2\u52a0\u304b\u3089\u7740\u5b9f\u306b\u30b7\u30b9\u30c6\u30e0\u30b9\u30c8\u30fc\u30ea\u30fc\u3042\u3089\u3086\u308b\u9762\u3067\u9032\u5316\u3057\u3066\u308b\u4f5c\u54c1\u3002<br \/>\n\u30e1\u30ac\u30c6\u30f3\u98a8\u3068\u3044\u3046\u3053\u3068\u3067\u69d8\u3005\u306a\u30aa\u30de\u30fc\u30b8\u30e5\u3092\u843d\u3068\u3057\u3069\u3053\u308d\u306b\u3057\u3066\u3044\u308b\u53cd\u9762<br \/>\n\u3053\u308c\u307e\u3067\u3042\u3063\u305f\u3048\u3050\u3055\u3069\u304e\u3064\u3055\u3092\u611f\u3058\u3055\u305b\u308b\u30a4\u30f3\u30d1\u30af\u30c8\u306f\u307b\u3093\u306e\u5c11\u3005\u8584\u308c\u3066\u3057\u307e\u3063\u305f\u306e\u306f\u60dc\u3057\u3044\u3068\u3053\u308d\u304b\u3002<br \/>\n\u3057\u304b\u3057\u30aa\u30ea\u30b8\u30ca\u30ea\u30c6\u30a3\u304c\u306a\u3044\u304b\u3068\u3044\u3046\u3068\u6c7a\u3057\u3066\u305d\u3093\u306a\u3053\u3068\u306f\u306a\u304f\u3001<br \/>\n\u5f8c\u534a\u306b\u306a\u308b\u306b\u3064\u308c\u3066\u8c79\u5909\u3082\u3057\u304f\u306f\u767a\u72c2\u3057\u3066\u3044\u304f\u5468\u56f2\u306e\u4eba\u7269\u3084\u72c2\u6c17\u3092\u601d\u308f\u305b\u308b\u30b9\u30c6\u30fc\u30b8\u306b<br \/>\n\u4e00\u30d5\u30a1\u30f3\u3068\u3057\u3066\u306b\u3084\u306b\u3084\u3057\u305f\u3002<br \/>\n\u30c9\u30c3\u30c8\u7d75\u306e\u518d\u73fe\u3082\u542b\u3081\u3066\u539f\u4f5c\u3092\u904a\u3093\u3060\u4eba\u3082\u3053\u308c\u307e\u3067\u6c0f\u306e\u4f5c\u54c1\u3092\u904a\u3093\u3060\u4eba\u4e21\u65b9\u304c\u697d\u3057\u3081\u308b\u51fa\u6765\u306b\u306a\u3063\u305f\u306e\u306f\u7d20\u6674\u3089\u3057\u3044<br \/>\n\u4fbf\u4e57\u3055\u3093\u306eif\u3082\u904a\u3093\u3067\u3044\u305f\u306e\u3067\u305d\u306e\u5909\u5316\u3092\u697d\u3057\u3080\u610f\u5473\u3067\u3082\u9762\u767d\u3044\u6642\u9593\u3092\u904e\u3054\u305b\u305f\u3002\u88fd\u4f5c\u611f\u8b1d"],[41,"2018-01-15","\u7121\u56de\u7b54","\u7121\u56de\u7b54"," "],[41,"2018-01-16","20\u4ee3","80%\u7537\u6027","\u6c0f\u306e\u30b2\u30fc\u30e0\u306f\u5730\u7344\u306e\u771f\u3063\u305f\u3060\u4e2d\u3067\u3057\u305f\u304b\u3089\u30d7\u30ec\u30a4\u3057\u3066\u305d\u306e\u72ec\u7279\u306a\u30a4\u30f3\u30d1\u30af\u30c8\u306b\u60f9\u304b\u308c\u3001\u3055\u3088\u30e2\u30ca\u3001\u30c0\u30fc\u30b8\u30e5\u3068\u30ea\u30ea\u30fc\u30b9\u3055\u308c\u308b\u305f\u3073\u306b\u30d7\u30ec\u30a4\u3057\u307e\u3057\u305f\u3002<br \/>\n\u3053\u306e\u5999\u306b\u751f\u3005\u3057\u3044\u4e16\u754c\u89b3\u3068\u4f5c\u98a8\u3001\u30e2\u30ca\u30fc\u3068\u3044\u3046\u4eca\u306f\u5bc2\u308c\u305f\uff1f\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30e2\u30c7\u30eb\u304c\u597d\u304d\u3067\u3064\u3044\u3064\u3044\u3002<br \/>\n\u30e1\u30ac\u30c6\u30f3\u306f\u672c\u5bb6\u306f\u3084\u3063\u305f\u3053\u3068\u306a\u304f\u3001\u3060\u3044\u305f\u3044\u4ed6\u4f5c\u8005\u306e\u30aa\u30de\u30fc\u30b8\u30e5\u4f5c\u304b\u3089\u5165\u308a\u307e\u3057\u305f\u304c\u3001\u3053\u306e\u4f5c\u54c1\u306f\u305d\u308c\u3092\u975e\u5e38\u306b\u30de\u30a4\u30eb\u30c9\u3001\u304b\u3064\u30b7\u30f3\u30d7\u30eb\u306b\u4ed5\u4e0a\u3052\u3066\u304a\u308a\u672c\u5bb6\u30b7\u30ea\u30fc\u30ba\u672a\u30d7\u30ec\u30a4\u3067\u3082\u6c17\u8efd\u306b\u697d\u3057\u3081\u308b\u7a0b\u3088\u3044\u96e3\u6613\u5ea6\u3067\u3057\u305f\u3002<br \/>\n\u4eca\u4f5c\u306f\u7279\u306b\u904e\u53bb\u4f5c\u3068\u6bd4\u3079\u3001\u4eba\u9593\u30c9\u30e9\u30de\u304c\u6df1\u304f\u3001\u6700\u5f8c\u306b\u306f\u8e0f\u307f\u8d8a\u3048\u308b\u58c1\u3068\u306a\u308b\u3082\u306e\u306e\u81ea\u5206\u306e\u9078\u629e\u306b\u3064\u3044\u3066\u8a8d\u3081\u305f\u4e0a\u3067\u3001\u8131\u843d\u3059\u308b\u6642\u3082\u6c7a\u3057\u3066\u5012\u3059\u3079\u304d\u60aa\u6575\u3068\u3057\u3066\u63cf\u304b\u308c\u308b\u3053\u3068\u306a\u304f\u6700\u5f8c\u307e\u3067\u4ef2\u9593\u3067\u3044\u3066\u304f\u308c\u305f\u308a\u3001\u3068\u2026<br \/>\n\u5404\u3005\u306e\u4e3b\u8981\u30ad\u30e3\u30e9\u9054\u306e\u845b\u85e4\u3082\u4e01\u5be7\u306b\u63cf\u304b\u308c\u3066\u3044\u3066\u3001\u611f\u60c5\u79fb\u5165\u3059\u308b\u306a\u3068\u3044\u3046\u65b9\u304c\u7121\u7406\u306a\u3082\u306e\u3067\u3057\u305f\u3002<br \/>\n\u6c0f\u306e\u72ec\u7279\u306e\u4eba\u3092\u9078\u3076\u8868\u73fe\u306f\u76f8\u5909\u308f\u3089\u305a\u306a\u3082\u306e\u306e\u3001\u3060\u304b\u3089\u3053\u305d\u306e\u30c9\u30e9\u30de\u3068\u3044\u3046\u611f\u3058\u3067\u3059\u3002<br \/>\n<br \/>\n\u30b0\u30c3\u30c9\u30a8\u30f3\u30c9\u3001\u78ba\u304b\u306b\u8e0f\u307f\u8d8a\u3048\u305f\u58c1\u306f\u3042\u308b\u3082\u306e\u306e\u3001\u7d50\u5c40\u611f\u60c5\u79fb\u5165\u3057\u305f\u304b\u3089\u3053\u305d\u3001\u751f\u3005\u3057\u304f\u73fe\u5b9f\u7684\u3060\u304b\u3089\u3053\u305d\u5927\u5207\u306a\u3044\u3064\u3082\u306e\u3001\u4ef2\u9593\u9054\u3068\u904e\u3054\u3059\u5f53\u305f\u308a\u524d\u306e\u81ea\u7531\u3092\u624b\u306b\u5165\u308c\u305f\u6642\u306f\u4f55\u7269\u306b\u3082\u4ee3\u3048\u304c\u305f\u3044\u611f\u52d5\u304c\u5f85\u3063\u3066\u3044\u307e\u3057\u305f\u3002\u307e\u3060\u305f\u3069\u308a\u7740\u3044\u3066\u3044\u306a\u3044\u4eba\u306f\u611f\u60c5\u79fb\u5165\u3057\u307e\u304f\u3063\u3066\u308b\u306a\u3089\u662f\u975e\u898b\u3066\u6b32\u3057\u3044\u3067\u3059\u3002<br \/>\n<br \/>\n\u30b7\u30b9\u30c6\u30e0\u306e\u95a2\u4fc2\u4e0a\u904e\u53bb\u4f5c\u3068\u9055\u3044\u304a\u91d1\u306b\u5236\u9650\u304c\u306a\u3044\u306e\u3067\u305d\u3046\u3044\u3046\u9762\u3067\u3082\u904a\u3073\u3084\u3059\u3044\u304b\u306a\u3068\u3002<br \/>\n\u305f\u3060\u3001\u904e\u53bb\u4f5c\u540c\u69d8\u306b\u30de\u30c3\u30d7\u306b\u304a\u91d1\u306f\u843d\u3061\u3066\u3044\u3066\u3001\u56de\u53ce\u6642\u306e\u53ce\u5165\u306f\u6575\u3092\u72e9\u308b\u3088\u308a\u52b9\u7387\u7684\u306a\u306e\u3067\u3001\u904e\u53bb\u4f5c\u306e\u30ce\u30ea\u3067\u652f\u51fa\u5236\u9650\u30d7\u30ec\u30a4\u3068\u304b\u3057\u3066\u3082\u652f\u969c\u306f\u3042\u3093\u307e\u308a\u3042\u308a\u307e\u305b\u3093\u3002<br \/>\n\u307b\u3093\u3068\u3069\u3046\u3057\u305f\u3089\u3053\u3093\u306a\u4e07\u4eba\u53d7\u3051\u3059\u308b\u7a0b\u3088\u3044\u7dca\u5f35\u611f\u3042\u308b\u30d0\u30e9\u30f3\u30b9\u304c\u3067\u304d\u308b\u3093\u3060\u308d\u3046\u2026<br \/>\n"],[41,"2018-01-17","20\u4ee3","\u5973\u6027","\u9762\u767d\u304b\u3063\u305f\uff01"],[41,"2018-01-19","90\u624d\u4ee5\u4e0a","\u7537\u6027","\u975e\u5e38\u306b\u4e01\u5be7\u306b\u5275\u3089\u308c\u3066\u3044\u3066\u3001\u7269\u8a9e\u3082\u3057\u3063\u304b\u308a\u3057\u3066\u308b\u4e0a\u3001\u5206\u5c90\u8981\u7d20\u306b\u53ce\u96c6\u3001\u5468\u56de\u307e\u3067\u3042\u308b\u81f3\u308c\u308a\u5c3d\u304f\u305b\u308a\u306e\u4f5c\u54c1\u3067\u3057\u305f\u3002<br \/>\n\u7269\u8a9e\u306b\u3064\u306a\u304c\u308a\u306f\u306a\u304f\u3066\u3082\u7d9a\u7de8\u304c\u3057\u305f\u3044\uff01\u3068\u5f37\u304f\u601d\u3063\u305f\u4f5c\u54c1\u3067\u3057\u305f\u3002"],[41,"2018-01-20","30\u4ee3","\u5973\u6027","\u3084\u3063\u3071\u308a\u597d\u304d\u3067\u3059"],[41,"2018-01-21","20\u4ee3","\u7537\u6027"," "],[41,"2018-01-24","20\u4ee3","\u5973\u6027","\u30e1\u30ac\u30c6\u30f3\u672a\u30d7\u30ec\u30a4\u3067\u3082\u308f\u304b\u308a\u3084\u3059\u3044\u30b7\u30b9\u30c6\u30e0\u3067\u3068\u3066\u3082\u697d\u3057\u3081\u307e\u3057\u305f\u3002<br \/>\n\u30c9\u30c3\u30c8\u7d75\u306e\u8868\u60c5\u3082\u8c4a\u304b\u3067\u5168\u30ad\u30e3\u30e9\u597d\u304d\u306b\u306a\u308c\u307e\u3057\u305f\u3002"],[41,"2018-01-26","20\u4ee3","\u4e2d\u6027","\u3053\u308c\u304d\u3063\u304b\u3051\u3067\u30e1\u30ac\u30c6\u30f3\u904a\u3093\u3067\u307f\u305f\u3089(\u3053\u308cnocturne\u3000else\u2026\u3067\u898b\u305f\uff01)\u3063\u3066\u306a\u3063\u3066\u697d\u3057\u304b\u3063\u305f\u3067\u3059\u3002\u30e1\u30ac\u30c6\u30f3\u597d\u304d\u3082\u521d\u898b\u306e\u4eba\u306b\u3082\u52e7\u3081\u305f\u3044\u30b2\u30fc\u30e0\u3067\u3057\u305f\uff01\u3042\u308a\u304c\u3068\u3046\u3054\u3056\u3044\u307e\u3057\u305f\uff01"],[41,"2018-01-26","30\u4ee3","\u7121\u56de\u7b54","\u5922\u4e2d\u3067\u30d7\u30ec\u30a4\u3057\u3066\u4f11\u65e5\u304c\u4e38\u4e00\u65e5\u6d88\u8cbb\u3055\u308c\u307e\u3057\u305f\u3002"],[41,"2018-01-27","30\u4ee3","\u7537\u6027","\u671f\u5f85\u3092\u88cf\u5207\u3089\u306a\u3044\u5927\u4f5c\u3060\u3063\u305f"],[41,"2018-01-27","20\u4ee3","\u5973\u6027","\u3053\u308c\u307e\u3067\u30ed\u30fc\u30bc\u30f3\u30af\u30ed\u30a4\u30c4\u6c0f\u304c\u767a\u8868\u3057\u305f\u4e09\u4f5c\u54c1\u3092\u30af\u30ea\u30a2\u3057\u3001\u305d\u306e\u4e0a\u3067\u307e\u3060\u304b\u307e\u3060\u304b\u3068\u5f85\u3061\u7d9a\u3051\u305f\u65b0\u4f5c\u304c\u300cNocturne Else\u2026\u300d\u3067\u3057\u305f\u3002\u305d\u3057\u3066\u6848\u306e\u5b9a\u3001\u30af\u30ea\u30b9\u30de\u30b9\u304b\u3089\u677e\u306e\u5185\u307e\u3067\u3053\u306e\u30b2\u30fc\u30e0\u306b\u6367\u3052\u3066\u3088\u3046\u3084\u304f\u4e00\u5468\u30af\u30ea\u30a2\u3057\u305f\u306e\u3067\u6295\u7968\u3055\u305b\u3066\u3044\u305f\u3060\u304d\u307e\u3057\u305f\uff01<br \/>\n<br \/>\n\u3053\u306e\u6b74\u4ee3\u6700\u5927\u30dc\u30ea\u30e5\u30fc\u30e0\u306b\u306f\u3068\u306b\u304b\u304f\u5727\u5012\u3055\u308c\u307e\u3057\u305f\u2026\u6642\u9593\u3082\u305d\u3046\u3067\u3059\u304c\u3001\u30b9\u30c8\u30fc\u30ea\u30fc\u3082\u3068\u3066\u3082\u6fc3\u5bc6\u3067\u3001\u6642\u306b\u6289\u3089\u308c\u6642\u306b\u52b1\u307e\u3055\u308c\u306a\u304c\u3089\u30d7\u30ec\u30a4\u3057\u307e\u3057\u305f\u3002\u60aa\u9b54\u3084\u5929\u4f7f\u306f\u30e6\u30fc\u30e2\u30e9\u30b9\u304b\u3064\u60e8\u9177\u3067\u3069\u3053\u304b\u611b\u5b0c\u304c\u3042\u308a\u3001\u4eba\u9593\u306f\u6642\u306b\u89e6\u308c\u5408\u3063\u3066\u306f\u96e2\u308c\u3001\u305d\u308c\u305e\u308c\u306e\u9053\u3092\u5f81\u304f\u59ff\u304c\u5bc2\u3057\u304f\u3082\u3042\u308a\u6c17\u9ad8\u304f\u3082\u3042\u308a\u2026\u8907\u96d1\u3067\u3059\u304c\u3001\u4f55\u3082\u304b\u3082\u304c\u300c\u597d\u304d\u300d\u3068\u601d\u3048\u308b\u7269\u8a9e\u3067\u3042\u308a\u307e\u3057\u305f\u3002<br \/>\n<br \/>\n\u30e1\u30ac\u30c6\u30f3\u306f\u4eca\u56de\u521d\u3081\u3066\u89e6\u308b\u30b8\u30e3\u30f3\u30eb\u3060\u3063\u305f\u306e\u3067\u3059\u304c\u3001UI\u306e\u512a\u79c0\u3055\u3068\u75d2\u3044\u6240\u306b\u624b\u304c\u5c4a\u304f\u30b9\u30c6\u30fc\u30b8\u30ae\u30df\u30c3\u30af\u3001\u60aa\u9b54\u5408\u4f53\u306e\u624b\u8efd\u3055\u3068\u30c6\u30af\u30cb\u30ab\u30eb\u3055\u306b\u6c17\u3065\u3044\u305f\u3089\u306e\u3081\u308a\u8fbc\u3093\u3067\u3044\u307e\u3057\u305f\u3002<br \/>\n\u88c5\u5099\u3082\u6b74\u4ee3\u30b2\u30fc\u30e0\u306e\u4e2d\u3067\u306f\u5c11\u306a\u3044\u65b9\u3067\u3059\u304c\u591a\u5f69\u3067\u3001\u5012\u3055\u308c\u3066\u306f\u4f55\u304c\u3042\u308c\u3070\u3088\u3044\u306e\u304b\u3068\u8a66\u884c\u932f\u8aa4\u3055\u305b\u3089\u308c\u308b\u3001\u30ec\u30d9\u30eb\u3092\u4e0a\u3052\u305f\u3060\u3051\u3067\u306f\u4f55\u3068\u304b\u306a\u3089\u306a\u3044\u7d76\u5999\u306a\u30d0\u30e9\u30f3\u30b9\u304c\u6700\u9ad8\u3067\u3057\u305f\u3002<br \/>\n<br \/>\n\u30b9\u30c8\u30fc\u30ea\u30fc\u304c\u9032\u3080\u307b\u3069\u306b\u73fe\u308c\u308b\u30ed\u30fc\u30bc\u30f3\u30af\u30ed\u30a4\u30c4\u7bc0\u3001\u305d\u3057\u3066\u5fb9\u982d\u5fb9\u5c3e\u8cab\u304b\u308c\u308b\u300c\u4eba\u306e\u4fa1\u5024\u3068\u306f\u4f55\u305e\u3084\u300d\u3068\u3044\u3046\u547d\u984c\u306b\u9b45\u4e86\u3055\u305b\u3089\u308c\u3063\u3071\u306a\u3057\u3067\u3059\u3002\u7b46\u3092\u304a\u3044\u305f\u3089\u3001\u307e\u305f\u4e8c\u5468\u4e09\u5468\u3068\u898b\u5c4a\u3051\u7d9a\u3051\u305f\u3044\u3068\u601d\u3044\u307e\u3059\u3002<br \/>\n\u4eca\u56de\u3082\u7d20\u6674\u3089\u3057\u3044\u4f5c\u54c1\u306b\u89e6\u308c\u3055\u305b\u3066\u3044\u305f\u3060\u304d\u307e\u3057\u305f\uff01\u6b21\u56de\u4f5c\u3082\u697d\u3057\u307f\u306b\u3057\u3066\u304a\u308a\u307e\u3059\u2026\u304c\u3001\u4eca\u306f\u304a\u75b2\u308c\u3055\u307e\u3001\u3068\u8a00\u308f\u305b\u3066\u3044\u305f\u3060\u304d\u307e\u3059\u3002\u3042\u308a\u304c\u3068\u3046\u3054\u3056\u3044\u307e\u3057\u305f\uff01"],[41,"2018-01-27","\u7121\u56de\u7b54","\u7121\u56de\u7b54","\u539f\u4f5c\u306e\u771f\u2162\u306f\u4eba\u9593\u306e\u6271\u3044\u304c\u7d50\u69cb\u30c9\u30e9\u30a4\u3060\u304c\u672c\u4f5c\u3067\u306f\u5dfb\u304d\u8fbc\u307e\u308c\u305f\u4e3b\u8981\u4eba\u7269\u304c\u81ea\u5206\u81ea\u8eab\u306e\u9053\u3092\u6b69\u3080\u307e\u3067\u306e\u8ab2\u7a0b\u3092\u6398\u308a\u4e0b\u3052\u3066\u3044\u308b<br \/>\n\u540c\u4f5c\u8005\u306e\u300c\u5730\u7344\u306e\u307e\u3063\u305f\u3060\u4e2d\u300d\u307b\u3069\u306e\u9b31\u3005\u3057\u3055\u306f\u306a\u3044\u304c\u6642\u3005\u30b5\u30a4\u30c9\u30d3\u30e5\u30fc\u306e\u30de\u30c3\u30d7\u3084\u500b\u6027\u7684\u3092\u901a\u308a\u8d8a\u3057\u3066\u6700\u65e9\u30ad\u30c4\u3044\u6575\u30ad\u30e3\u30e9\u305f\u3061\u306a\u3069\u8594\u8587\u5341\u5b57\u30c6\u30a4\u30b9\u30c8\u306f\u6e80\u8f09<br \/>\n\u30a6\u30ca\u30ae\u306e\u3054\u3068\u304f\u6e1b\u5c11\u306e\u4e00\u9014\u3092\u305f\u3069\u308b2ch\u7cfb\u30c4\u30af\u30e9\u30fc\u306e\u4e2d\u3067\u3082\u30c8\u30c3\u30d7\u30af\u30e9\u30b9\u306e\u5b9f\u529b\u3092\u4eca\u56de\u3082\u5b58\u5206\u306b\u767a\u63ee\u3057\u3066\u304f\u308c\u305f"],[41,"2018-01-27","20\u4ee3","\u5973\u6027","NEUTRAL\u30af\u30ea\u30a2 CHAOS\u30fbLAW\u3000\u4ed6\u30eb\u30fc\u30c8 \u672a\u30af\u30ea\u30a2<br \/>\n\u30ea\u30ca\u30ef\u30fc\u30eb\u30c9\u304c\u5922\u306b\u51fa\u308b\u304f\u3089\u3044\u5370\u8c61\u7684\u3060\u3063\u305f\u306e\u3067\u6295\u7968<br \/>\n\u767b\u5834\u4eba\u7269\u305f\u3061\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u6027\u3084\u6700\u7d42\u7684\u306b\u76ee\u6307\u3057\u3066\u3044\u304f\u9053\u304c<br \/>\n\u5b66\u751f\u306e\u9032\u8def\u3084\u307c\u3093\u3084\u308a\u3068\u3057\u305f\u5c06\u6765\u3092\u793a\u5506\u3057\u3066\u3044\u308b\u3088\u3046\u3067<br \/>\n\u5206\u304b\u308a\u6613\u3044\u4f5c\u54c1\u3060\u3063\u305f<br \/>\n\u6226\u95d8\u3082\u4ef2\u9b54\u30b7\u30b9\u30c6\u30e0\u304c\u9762\u767d\u304f\u65b0\u30ad\u30e3\u30e9\u3092\u898b\u308b\u305f\u3073\u306b<br \/>\n\u300c\u3042\u3000\u30b3\u30a4\u30c4\u521d\u898b\u3060\u306a\u300d\u3068\u304b<br \/>\n\u300c\u3044\u3084\u3053\u3044\u3064\u4ef2\u9b54\u306e\u3068\u304d\u3053\u3053\u307e\u3067\u5f37\u304f\u306a\u304b\u3063\u305f\u3058\u3083\u3093\u300d<br \/>\n\u3063\u3066\u611f\u3058\u3067\u30e2\u30c1\u30d9\u30fc\u30b7\u30e7\u30f3\u304c\u4fdd\u3066\u305f<br \/>\n<br \/>\n\u30ab\u30b0\u30c4\u30c1\u306f\u5805\u3059\u304e\u3066\u3061\u3087\u3063\u3068\u840e\u3048\u304b\u3051\u305f\u3051\u3069<br \/>\n\u305d\u306e\u5206\u723d\u3084\u304b\u306a\u30a8\u30f3\u30c7\u30a3\u30f3\u30b0\u3092\u4e00\u5c64\u969b\u7acb\u305f\u305b\u305f\u3088\u3046\u306b\u601d\u3046"],[41,"2018-01-28","30\u4ee3","\u7537\u6027","\u9762\u767d\u3044\u3000\u3068\u8868\u73fe\u3059\u308b\u3079\u304d\u304b\u3001\u51c4\u3044\u3000\u3068\u8868\u73fe\u3059\u308b\u3079\u304d\u304b<br \/>\n\u30c4\u30af\u30fc\u30eb\uff12\uff10\uff10\uff10\u3067\u3053\u306e\u3088\u3046\u306a\u4f5c\u54c1\u3092\u4f5c\u308a\u4e0a\u3052\u308b\u4f5c\u8005\u306b\u8131\u5e3d<br \/>\n\u672a\u3060\u3001\u672c\u7de8\u30af\u30ea\u30a2\u307e\u3067\u8fbf\u308a\u7740\u3051\u3066\u3044\u306a\u3044\u6642\u70b9\u3067\u306e\u8a55\u4fa1\u3067\u3059\u304c<br \/>\n\u975e\u5e38\u306b\u697d\u3057\u3093\u3067\u304a\u308a\u307e\u3059\u3001\u3053\u306e\u30b2\u30fc\u30e0\u3092\u30d7\u30ec\u30a4\u3067\u304d\u3066\u5e78\u305b\u3067\u3059"],[42,"2018-01-04","20\u4ee3","\u7537\u6027","\u521d\u6295\u7a3f\u3089\u3057\u304b\u3089\u306c\u771f\u9762\u76ee\u306a\u4f5c\u308a\u3060\u304c\u3001\u521d\u6295\u7a3f\u3089\u3057\u3044\u30ad\u30e3\u30e9\u306e\u30d9\u30fc\u30b7\u30c3\u30af\u3055\uff01<br \/>\n\u4f55\u3088\u308a\u771f\u9762\u76ee\u306b\u8a71\u304c\u9032\u3080\u2026\u3002\u5e74\u672b\u30c6\u30f3\u30b7\u30e7\u30f3\u306eksg\u306b\u62bc\u3057\u6f70\u3055\u308c\u3066\u98df\u50b7\u6c17\u5473\u306b\u306a\u3063\u305f\u6642\u306b\u30b9\u30fc\u3063\u3068\u67d3\u307f\u6e21\u308b\u6e05\u6dbc\u5264\u306e\u3088\u3046\u306a\u3042\u308a\u304c\u305f\u3044\u30dd\u30b8\u30b7\u30e7\u30f3\u306e\u30b2\u30fc\u30e0\u3060\u3063\u305f\u3002<br \/>\n\u3053\u3053\u307e\u3067\u81ea\u5206\u52dd\u624b\u306a\u611f\u60f3\u3070\u304b\u308a\u3067\u6050\u7e2e\u3060\u304c\u3001\u3057\u3063\u304b\u308a\u3057\u305f\u30b2\u30fc\u30e0\u3092\u4f5c\u3089\u308c\u308b\u4f5c\u8005\u306a\u306e\u3067\u4eca\u5f8c\u306b\u671f\u5f85\u3057\u305f\u3044\u3002"],[42,"2018-01-13","20\u4ee3","\u7121\u56de\u7b54","\u662f\u975e\u30a2\u30fc\u30b1\u30f3\u3055\u3093\u306b\u306f\u9b54\u738b\u8ecd\u306b\u5b9a\u7740\u3057\u3066\u3082\u3089\u3044\u305f\u3044\u3067\u3059\u3002"],[42,"2018-01-18","20\u4ee3","\u7537\u6027","\u6614\u306e\u30ad\u30e3\u30e9\u306b\u30b9\u30dd\u30c3\u30c8\u3092\u3042\u3066\u3066\u3044\u305f\u70b9\u306f\u3082\u3061\u308d\u3093\u3001\u30b9\u30c8\u30fc\u30ea\u30fc\u3082\u306a\u304b\u306a\u304b\u826f\u304b\u3063\u305f\u3002<br \/>\n\u30a2\u30fc\u30b1\u30f3\u3055\u3093\u306e\u4eca\u5f8c\u306e\u6d3b\u8e8d\u306b\u671f\u5f85\u3002"],[42,"2018-01-28","20\u624d\u672a\u6e80","\u305d