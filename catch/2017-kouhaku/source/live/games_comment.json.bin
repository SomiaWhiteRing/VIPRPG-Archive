306e\u6280\u6cd5\u306f\u660e\u3089\u304b\u306b\u5358\u306a\u308b\u30c4\u30af\u30e9\u30fc\u306e\u4f59\u6280\u3001\u4f59\u8208\u3084\u6240\u8b02\uff4b\uff53\uff47\u306e\u5ef6\u9577\u304b\u3089\u51fa\u767a\u3057\u305f\u898b\u308b\u30b2\u3068\u3044\u3046\u5a92\u4f53\u306e\u4fa1\u5024\u3092\u66f4\u306b\u4e00\u6bb5\u5f15\u304d\u63da\u3052\u308b\u3082\u306e\u3067\u3042\u308b\u3068\u78ba\u4fe1\u3057\u3066\u3044\u307e\u3059\u3002\u30bf\u30a4\u30c8\u306b\u7df4\u3089\u308c\u305f\u30b7\u30ca\u30ea\u30aa\u3001\u5834\u9762\u69cb\u6210\u3067\u3042\u308a\u306a\u304c\u3089\u3001\u672c\u7b4b\u306e\u30b7\u30ca\u30ea\u30aa\u306b\u5c40\u5730\u6226\u306e\u30b9\u30b1\u30c3\u30c1\u3084\u795e\u8a71\u306e\u5287\u4e2d\u5287\u3092\u633f\u5165\u3059\u308b\u4e8b\u3067\u4e16\u754c\u89b3\u3092\u6398\u308a\u4e0b\u3052\u308b\u3068\u3044\u3046\u96e3\u696d\u3092\u6210\u3057\u9042\u3052\u3001\u9b54\u6cd5\u30d0\u30c8\u30eb\u3082\u306e\u3067\u3042\u308a\u306a\u304c\u3089\u201cAKIRA\u201d\u306e\u3088\u3046\u306a\u30b5\u30a4\u30ad\u30c3\u30af\u30d0\u30c8\u30eb\u3092\u601d\u308f\u305b\u308b\u7570\u8cea\u306a\u6226\u95d8\u63cf\u5199\u306f\u6d3e\u624b\u306a\u6226\u95d8\u30a2\u30cb\u30e1\u3084\u6ed1\u3089\u304b\u306a\u30c9\u30c3\u30c8\u30a2\u30cb\u30e1\u30fc\u30b7\u30e7\u30f3\u3092\u7528\u3044\u305a\u3068\u3082\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u76ee\u3092\u60f9\u304d\u3064\u3051\u308b\u4e8b\u304c\u53ef\u80fd\u3060\u3068\u8a3c\u660e\u3057\u307e\u3057\u305f\u3002\u307e\u305f\u3001\u4e00\u822c\u7684\u306b\u306f\u656c\u9060\u3055\u308c\u304c\u3061\u306a\u54f2\u5b66\u3081\u3044\u305f\u53f0\u8a5e\u56de\u3057\u3001\u72ec\u81ea\u306e\u4e16\u754c\u89b3\u306b\u57fa\u3065\u3044\u3066\u3044\u308b\u304c\u70ba\u306e\u8aac\u660e\u53f0\u8a5e\u3082\u5b8c\u5168\u306a\u7406\u89e3\u3092\u8981\u6c42\u3057\u3066\u304a\u3089\u305a\u6216\u3044\u306f\u4e00\u7a2e\u306e\u8a69\u306e\u3088\u3046\u306b\u4f5c\u54c1\u3092\u5f69\u308a\u3001\u898b\u308b\u30b2\u306e\u7279\u8cea\u3067\u3042\u308b\u30c6\u30ad\u30b9\u30c8\u3068\u3044\u3046\u6a5f\u80fd\u306e\u529b\u3092\u3088\u304f\u767a\u63ee\u305b\u3057\u3081\u3066\u3044\u308b\u3068\u611f\u3058\u307e\u3059\u3002<br \/>\n\u4ee5\u4e0a\u306e\u3088\u3046\u306a\u898b\u308b\u30b2\u53f2\u7684\uff08\uff1f\uff09\u4fa1\u5024\u3092\u63aa\u3044\u3066\u3082\u3001\u672c\u4f5c\u3067\u8a9e\u3089\u308c\u308b\u6d41\u308c\u308b\u8840\u6f6e\u306e\u5982\u304d\u7269\u8a9e\u306f\u5358\u7d14\u306b\u30a8\u30f3\u30bf\u30fc\u30c6\u30a4\u30e1\u30f3\u30c8\u3068\u3057\u3066\u512a\u308c\u3066\u3044\u307e\u3059\u3002<br \/>\n\u4e3b\u6d41\u306e\u3082\u3057\u3082\u304b\u3089\u96e2\u308c\u305f\u4e16\u754c\u89b3\u304b\u3089\u300c\u96e3\u89e3\u300d\u300c\u3088\u304f\u5206\u304b\u3089\u306a\u3044\u300d\u7b49\u306e\u5370\u8c61\u3092\u53d7\u3051\u3066\u672a\u30d7\u30ec\u30a4\u306e\u65b9\u3001\u59cb\u3081\u3066\u76f4\u3050\u6295\u3052\u51fa\u3057\u3066\u3057\u307e\u3063\u305f\u65b9\u306f\u5fc5\u305a\u30d7\u30ec\u30a4\u3057\u3066\u4e0b\u3055\u3044\u3002\u5f8c\u6094\u3057\u307e\u3059\u3088\uff01"],[8,"2018-01-21","20\u4ee3","\u7537\u6027","\u9762\u767d\u304b\u3063\u305f"],[8,"2018-01-28","\u7121\u56de\u7b54","\u7121\u56de\u7b54","\u30d0\u30ca\u30ca\u3068\u8a00\u3063\u305f\u3089\u9ec4\u8272\u3000\u9ec4\u8272\u3068\u8a00\u3063\u305f\u3089\u30ec\u30e2\u30f3"],[8,"2018-01-28","20\u4ee3","\u7537\u6027","70\u6642\u9593\u8d85\u304b\u3051\u3066\u30e9\u30b9\u30dc\u30b9\u307e\u3067\u30af\u30ea\u30a2\u3057\u305f\u305e\u30aa\u30e9\u30a1\uff01<br \/>\n\u30d0\u30ea\u30a8\u30fc\u30b7\u30e7\u30f3\u8c4a\u304b\u306a\u30dc\u30b9\u3068\u5473\u65b9\u3068\u88c5\u5099\u3068\u3092\u30d5\u30eb\u306b\u6d3b\u7528\u3057\u305f\u9577\u7de8\u30b2\u30fc\u3067\u5927\u5909\u697d\u3057\u304b\u3063\u305f\u3067\u3059\uff01"],[11,"2018-01-05","20\u4ee3","\u7537\u6027","\u6025\u901f\u306b\u767a\u9054\u3059\u308b\u5175\u5668\u306b\u3088\u3063\u3066\u79fb\u308a\u5909\u308f\u308b\u6642\u4ee3\u3002<br \/>\n\u305d\u3093\u306a\u4e2d\u3001\u5263\u3092\u632f\u308b\u3046\u3053\u3068\u3067\u3057\u304b\u751f\u304d\u3089\u308c\u306a\u304b\u3063\u305f\u8005\u305f\u3061\u306e\u7269\u8a9e\u3002\u3068\u3066\u3082\u71b1\u3044\u75fa\u308c\u308b\u4f5c\u54c1\u3067\u3059\u3002<br \/>\n\u30c6\u30ad\u30b9\u30c8\u30e8\u30b7\u3001\u6f14\u51fa\u30e8\u30b7\u3001BGM\u30e8\u30b7\u3001\u672c\u5f53\u306b\u7d20\u6674\u3089\u3057\u3044\u4f5c\u54c1\u3002<br \/>\n\u6551\u3044\uff1f\u5f7c\u3089\u306b\u3068\u3063\u3066\u306e\u6551\u3044\u306f\u6226\u5834\u3067\u5263\u3092\u632f\u308b\u3046\u3053\u3068\u306b\u3042\u308b\u306e\u3060\uff01"],[11,"2018-01-13","20\u4ee3","\u7121\u56de\u7b54","\u6226\u95d8\u30b7\u30fc\u30f3\u304c\u3059\u3054\u3059\u304e\u308b\uff01\uff01<br \/>\n\u6642\u4ee3\u306e\u6d41\u308c\u306b\u53d6\u308a\u6b8b\u3055\u308c\u3066\u4e0d\u5668\u7528\u306b\u751f\u304d\u308b\u3057\u304b\u306a\u3044\u30c9\u30e9\u30ca\u3068\u30b3\u30f3\u30e9\u30fc\u30c8\u306e\u95a2\u4fc2\u304c\u6700\u9ad8\u3067\u3057\u305f\u3002<br \/>\n\u3042\u308b\u304b\u3082\u3057\u308c\u306a\u3044\u7d9a\u7de8\u306b\u3082\u671f\u5f85\u3057\u3066\u3044\u307e\u3059\uff01"],[11,"2018-01-13","20\u4ee3","\u7537\u6027","\u6f14\u51fa\u304c\u826f\u3044\u3002<br \/>\n\u30dc\u30fc\u30a4\u30df\u30fc\u30c4\u30ac\u30fc\u30eb\u3068\u3057\u3066\u3082\u3001\u738b\u56fd VS \u9b54\u738b\u8ecd\u898b\u308b\u30b2\u3068\u3057\u3066\u3082\u5091\u4f5c"],[11,"2018-01-13","20\u4ee3","\u7537\u6027","\u6f14\u51fa\u529b\u304c\u51c4\u3044\u3002<br \/>\n\u30dc\u30fc\u30a4\u30df\u30fc\u30c4\u30ac\u30fc\u30eb\u3068\u3057\u3066\u3082\u3001\u738b\u56fd VS \u9b54\u738b\u8ecd\u898b\u308b\u30b2\u3068\u3057\u3066\u3082\u5091\u4f5c"],[11,"2018-01-17","30\u4ee3","\u7537\u6027","\u3059\u3054\u304f\u3088\u304b\u3063\u305f"],[11,"2018-01-24","\u7121\u56de\u7b54","\u7121\u56de\u7b54","\u8ecd\u5236\u306e\u5909\u9769\u306f\u6b74\u53f2\u30fb\u6226\u8a18\u7269\u3067\u306f\u666e\u904d\u6027\u306e\u3042\u308b\u30c6\u30fc\u30de\u3060\u304c\u30d5\u30a1\u30f3\u30bf\u30b8\u30fc\u3067\u305d\u306e\u60b2\u54c0\u3092\u3088\u304f\u63cf\u3044\u3066\u3044\u308b"],[11,"2018-01-24","20\u4ee3","\u7537\u6027","\u30b3\