			background-color: rgba(255, 255, 255, 0.7);
			width:600px
		}
		.t {
			font-weight:600;
			font-size:13px;
		}
		.m {
				font-size:1rem;
				font-weight: 600;
				background: linear-gradient(transparent 82%, rgba(90, 160, 240, 0.4) 18%); ;
			}
		table td {
			border: dashed 1px #999;
			padding:1px
		}
