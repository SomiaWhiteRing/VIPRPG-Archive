body{background:image-set(url('./img/back.avif') type('image/avif'),url('./img/back.jpg') type('image/jpeg'));background-attachment:fixed;background-repeat:no-repeat;background-size:cover;color:#666;font-size:16px;font-family:'Helvetica Neue','Helvetica','Noto Sans','Hiragino Kaku Gothic Pro','Noto Sans CJK JP','Meiryo','MS PGothic',sans-serif;letter-spacing:normal;word-break:break-all;word-wrap:break-word;margin:0;padding:0;-webkit-text-size-adjust:none;line-height:1;margin:0}a:link{color:#999;text-decoration:none}a:hover{color:#999;text-decoration:none}a:visited{color:#999;text-decoration:none}ul{padding:0}li{list-style:none}.wrapTop{max-width:600px;margin:50px auto;display:flex;justify-content:space-between}.wrapTop-leftside{margin-left:20px}.wrapTop-leftside-sitename{width:320px;border-bottom:2px solid #a5a4a4;font-size:32px;font-family:'Asap',sans-serif;font-weight:500;color:#656565;position:relative;text-align:center}.wrapTop-leftside-sitename:before{content:"";position:absolute;width:7px;height:7px;top:42px;left:320px;background:#a5a4a4;border-radius:50%}
.wrapTop-leftside-navList{margin-bottom:50px}.wrapTop-leftside-navList>li{line-height:3;font-family:'Asap',sans-serif}.wrapTop-leftside-navList>li>a{width:100%;display:block}.wrapTop-leftside-navList>li>a:hover{background:#555;color:#fff;transition:.8s}.wrapTop{display:block}.wrapTop-leftside{display:flex;margin-bottom:50px}.wrapTop-leftside-nav{display:none}#nav-drawer{position:relative;margin:0 0 0 auto}.nav-unshown{display:none}#nav-open{display:inline-block;width:30px;margin:0 30px 0 0}#nav-open span,#nav-open span:before{position:absolute;height:48px;width:48px;display:block}#nav-open span:before{content:'';height:6px;width:48px;background:#333;border-radius:4px;-webkit-border-radius:4px;-moz-border-radius:4px;display:block;position:absolute;top:5px;left:0;box-shadow:0 12px #333,0 24px #333;-webkit-box-shadow:0 12px #333,0 24px #333;-moz-box-shadow:0 12px #333,0 24px #333}#nav-close{display:none;position:fixed;z-index:99;top:0;left:0;width:100%;height:100%;background:#000;opacity:0;transition:.3s ease-in-out}
#nav-content{overflow:auto;position:fixed;top:0;left:0;z-index:9999;width:90%;max-width:240px;height:100%;background:#fff;transition:.3s ease-in-out;-webkit-transform:translateX(-105%);transform:translateX(-105%)}#nav-input:checked~#nav-close{display:block;opacity:.5}#nav-input:checked~#nav-content{-webkit-transform:translateX(0%);transform:translateX(0%);box-shadow:6px 0 25px rgba(0,0,0,.15)}.nav-drawerList{list-style:none;text-align:center;padding:0}.nav-drawerList-item{line-height:1.5}.nav-drawerList-item>a{display:block;padding:15px}.wrapTop-leftside{margin-left:0}}.wrapTop-rightside{width:200px;height:40px;margin:0 auto}.wrapTop-rightside img{width:100%;height:100%;object-fit:cover;font-family:'object-fit: cover;'}@media screen and (max-width:600px){.wrapTop-rightside{width:100%;height:100%;margin:0 auto}}.wrapUnder{margin:0 auto;text-align:center;background:#f2f2f2}.wrapUnder-title{width:190px;margin:0 auto 50px;padding:30px 0 10px;font-size:24px;font-family:'Asap',sans-serif;position:relative}
.wrapUnder-title:before{content:'';position:absolute;display:block;bottom:-5px;width:60px;height:1px;left:50%;-webkit-transform:translateX(-50%);transform:translateX(-50%);background-color:#656565}.wrapUnder-contents{max-width:1116px;margin:0 auto 50px}.wrapUnder-contents-list{display:flex;flex-wrap:wrap;justify-content:space-around}.wrapUnder-contents-listItem{width:250px;height:250px;margin-bottom:20px;background:#fff;text-align:left}.wrapUnder-contents-listItem2{width:250px;height:250px;margin-bottom:20px;background:#ffc0c0;text-align:left}.wrapUnder-contents-listItem:hover{opacity:.8}.wrapUnder-contents-listItem-img{width:250px;height:130px}.wrapUnder-contents-listItem-img img{width:100%;height:100%;object-fit:cover;font-family:'object-fit: cover;'}.wrapUnder-contents-listItem-descriptionDate{padding:0 10px;font-size:1px;color:#999;line-height:2}.wrapUnder-contents-listItem-descriptionTitle{padding:0 0 4px;font-size:12px;font-weight:700}.wrapUnder-contents-listItem-descriptionText{padding:0 0 10px;font-size:12px}
.wrapUnder-button{padding-bottom:50px}.wrapUnder-button>a{font-size:20px;font-weight:700;background:#fff;padding:10px 80px;border-radius:50px}.wrapUnder-button>a:hover{opacity:.8}@media(max-width:600px){.wrapUnder-contents-list{flex-direction:column}.wrapUnder-contents-listItem{width:100%;height:calc(100vmin - 17px);margin-bottom:20px;background:#fff;text-align:left}.wrapUnder-contents-listItem-img{width:100%;height:60%}.wrapUnder-contents-listItem2{width:100%;height:calc(100vmin - 17px);margin-bottom:20px;background:#ffc0c0;text-align:left}}.footer-text{margin:0 auto;padding:0;list-style:none;display:flex;text-align:center;justify-content:center}.footer-SNSicon{margin:0 auto 10px;padding:0;list-style:none;display:flex;justify-content:center}.snsIcon{width:200px;height:40px;margin:0 0 0 10px}.footer{border-top:1px solid #ccc;text-align:center;padding:20px 0;font-size:24px;background:#f2f2f2}.color0{background-color:#fff}.color0_cener{background-color:#2ba;text-align:center}.color1{background-color:#5ed}
.color1_cener{background-color:#5ed;text-align:center}.color2{background-color:#bcd}.color2_cener{background-color:#bcd;text-align:center}.color3{background-color:#eef}.color3_cener{background-color:#def;text-align:center}