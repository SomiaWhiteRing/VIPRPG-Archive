    <TR>
      <TD bgcolor="#ffffff"><A href="http://www.geocities.jp/vipkohaku_second_04/kohaku_071.zip">ダウンロード（4.78MB）</A><FONT size="+1" face="ＭＳ Ｐ明朝" color="#008000"><B>[2003製]</B></FONT></TD>
