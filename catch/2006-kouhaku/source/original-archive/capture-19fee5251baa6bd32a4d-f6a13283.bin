    <TR>
      <TD bgcolor="#ffe8e8">No,029　【キャプテンドラゴナス．アルティメットイグニッション】</TD>
    </TR>
    <TR>
      <TD width="640" height="480"><IMG src="ss_29.png" width="640" height="480" border="0"></TD>
