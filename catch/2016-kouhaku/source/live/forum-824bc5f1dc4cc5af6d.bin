        <dt id="comment_2">
          <a href="https://jbbs.shitaraba.net/bbs/read.cgi/game/59992/1480870744/2" rel="nofollow">2</a>：<!--
          --><font color="#009E25"><!--
            
            --><b>名無しさん</b><!--
            
