    .strb_youtube {
      width:100%;
      max-width:560px;
    }

    .strb_youtube_iframe {
      position: relative;
      width: 100%;
      padding-top: 56.25%;
      margin-bottom:50px;
    }
    .strb_youtube_iframe iframe {
      position: absolute;
      top: 0;
      right: 0;
      width: 100%;
      height: 100%;
    }
    </style>

