/* common */

body {
	font-size: 100%;
	line-height: 140%;
	font-family: Arial,Helvetica,sans-serif;
	color: #000;
	text-align: center;
	background: #fff;
}

a:link { text-decoration:underline; color: #000;}
a:visited { text-decoration:underline; color: #000;}
a:active { text-decoration:underline; color: #000;}
a:hover { text-decoration:none; color: #000;}

html , body {height:100%;}
body > #container {height:auto;}

h2 {
	padding: 30px 0;
	width: 100%;
	font-size: 12px;
	text-align: center;
}


#container {
	width: 840px;
	margin-right: auto;
	margin-left: auto;
	text-align: center;
}

#balloonbox {
	margin: 0 auto;
	margin-bottom: 0px;
	width:  840px;
	height: 88px;
	left:     0px;
	position: relative;
	background-repeat: no-repeat;
	background-position: left center;"
}

#ballooninner {
	margin: 0 auto;
	padding: 8px;
	width:  800px;
	height: 48px;
	left:     0px;
	text-align: left;
	position: relative;
	background-repeat: no-repeat;
	background-position: left center;"
}

.back {
	padding:40px 0px 0px 0px;
	background:url(img/back1_top.png) no-repeat left top;
}

.back .body {
	background:url(img/back1_body.png) repeat-y left top;
}


#box2 {
