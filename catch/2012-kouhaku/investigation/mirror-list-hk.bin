	left:    60px;
	position: relative;
	text-align: left;
	color: #000;
}


#entrylist table {
	border: 3px solid #cccccc;	/*外枠の線*/
	width: 100%;
}

#entrylist td, #entrylist th {
	border: 1px solid #000000;	/*内枠の線。ここでは点線(IE6前だと破線で表示される)に設定*/
	padding: 5px 5px;			/*余白*/
	line-height: 1.0;
}

#entrylist td.s, #entrylist th.s {
	background-color: #000000;
	border: 1px solid #000000;	/*内枠の線。ここでは点線(IE6前だと破線で表示される)に設定*/
	padding: 0px 0px;			/*余白*/
	line-height: 1.0;
	height: 8px;
}

#entrylist th.red, #entrylist td.red {
	background-color: #ff7777;
