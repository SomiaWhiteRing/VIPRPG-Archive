/* common */

body {
	font-size: 100%;
	line-height: 140%;
	font-family: Arial,Helvetica,sans-serif;
	color: #000;
	text-align: center;
	background: #fff;
}

a:link { text-decoration:underline; color: #000;}
a:visited { text-decoration:underline; color: #000;}
a:active { text-decoration:underline; color: #000;}
a:hover { text-decoration:none; color: #000;}

html , body {height:100%;}
body > #container {height:auto;}

h2 {
	padding: 30px 0;
	width: 100%;
	font-size: 12px;
	text-align: center;
}


#container {
	width: 840px;
	margin-right: auto;
	margin-left: auto;
	text-align: center;
}

#balloonbox {
	margin: 0 auto;
	margin-bottom: 0px;
	width:  840px;
	height: 88px;
	left:     0px;
	position: relative;
	background-repeat: no-repeat;
	background-position: left center;"
}

#ballooninner {
	margin: 0 auto;
	padding: 8px;
	width:  800px;
	height: 48px;
	left:     0px;
	text-align: left;
	position: relative;
	background-repeat: no-repeat;
	background-position: left center;"
}

.back {
	padding:40px 0px 0px 0px;
	background:url(img/back1_top.png) no-repeat left top;
}

.back .body {
	background:url(img/back1_body.png) repeat-y left top;
}


#box2 {
	width: 720px;
	padding: 0px 0px 0px 0px;
	left:    60px;
	position: relative;
	text-align: left;
	color: #000;
}


#entrylist table {
	border: 3px solid #cccccc;	/*外枠の線*/
	width: 100%;
}

#entrylist td, #entrylist th {
	border: 1px solid #000000;	/*内枠の線。ここでは点線(IE6前だと破線で表示される)に設定*/
	padding: 5px 5px;			/*余白*/
	line-height: 1.0;
}

#entrylist td.s, #entrylist th.s {
	background-color: #000000;
	border: 1px solid #000000;	/*内枠の線。ここでは点線(IE6前だと破線で表示される)に設定*/
	padding: 0px 0px;			/*余白*/
	line-height: 1.0;
	height: 8px;
}

#entrylist th.red, #entrylist td.red {
	background-color: #ff7777;
	vertical-align: middle;
}

#entrylist th.white, #entrylist td.white {
	background-color: #FFFFFF;
	vertical-align: middle;
}

#entrylist td.gray, #entrylist th.gray {
	background-color: #EEEEEE;
	vertical-align: middle;
}

#entrylist td.dgray, #entrylist th.dgray {
	background-color: #AAAAAA;
	vertical-align: middle;
}

#entrylist td.black, #entrylist th.black {
	background-color: #000000;
	vertical-align: middle;
}

#entrylist th {
	background-color: #fafafa;	/*左側（table midashi部分）の背景色*/
	padding: 0px 0px;			/*余白*/
	height: 32px;
	width:  32px;
	text-align: center;
}

.pagetop {
	text-align: center;
}

.new dl {
	width: 100%;			/*ボックスの幅*/
	height: 100px;			/*ボックスの高さ*/
	overflow: auto;
	padding-left: 0px;
}

.new dt {
	font-weight: bold;	/*日付の色を太字にする*/
	color: #A63737;		/*日付の文字色*/
}

.new dd {
	border-bottom: 1px solid #FFD0D0;	/*日付ごとの下線*/
	color: #000000;		/*文字色*/
}

/* Navigation */
.nav, .nav ul { 
	list-style: none;
	margin: 0;
	padding: 0;
}

.nav {
  font-family: Arial, Helvetica, sans-serif;
  z-index: 100;
  position: relative;
}
.nav li {
  border-left: 1px solid #fff;
  float: left;
