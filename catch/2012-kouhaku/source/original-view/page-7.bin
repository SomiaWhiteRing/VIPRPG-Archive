}

.nav li a:hover {
  background: #ff7777;
  color: #fff;	

}
#nav-one li:hover a, 
#nav-one li.sfHover a {
  background: #ff7777;
  color: #fff;
}
#nav-one li:hover ul a, 
#nav-one li.sfHover ul a {
  background: #fff;
  color: #000;	
}
#nav-one li:hover ul a:hover, 
#nav-one li.sfHover ul a:hover {
  background: #ff7777;
  color: #fff;	
}

.nav ul {
  background: #565656;
  border-bottom: 1px solid #000;
  list-style: none;
  margin: 0;
  width: 110px;
  position: absolute;
  top: -999em;
  left: -1px;
}
.nav li:hover ul,
.nav li.sfHover ul {
  top: 25px;
}
.nav ul li {
  border: 0;
  float: none;
}
.nav ul a {
  border: 1px solid #000;
  border-bottom: 0;
  padding-right: 20px;
  width: 90px;
  white-space: nowrap;
}
.nav ul a:hover {
