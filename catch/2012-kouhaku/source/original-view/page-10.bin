      var tag2 = document.getElementById("geniee_overray_base");
      tag1.style.bottom = 0 + "px";
      tag2.style.bottom = 0 + "px";
      tag1.style.zIndex = 9999;
      tag2.style.zIndex = 9999;
      body.style.zIndex = 2;
      document.getElementById("geniee_overray_closed").onclick = function(){
          tag1.style.display = "none";
          tag2.style.display = "none";
      };
  });

  function addOnEvent(event,func) {
            try {
                window.addEventListener(event, func, false);
            } catch (e) {
                // IE
                window.attachEvent("on" + event , func);
            }
   }  

  function getPosition() {
      var tags = document.getElementById('geniee_overray_tag');
      tags.style.top = "";
      tags.style.bottom = 0 + "px";
      tags.style.position = "fixed";
      var tags1 = document.getElementById('geniee_overray_base');
      tags1.style.top = "";
      tags1.style.bottom = 0 + "px";
      tags1.style.position = "fixed";
  }
})();
</script>


