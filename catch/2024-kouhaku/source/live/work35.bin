    <tr>
    <td colspan="2" align="center">
      <img id="pic_ss" onclick="slideshow()" src="./ss/ss35.png" width="640" height="480">
            <script>
            var pics_src = new Array("./ss/ss35.png","./ss/ss35a.png","./ss/ss35b.png","./ss/ss35c.png");
            var num = 0;

            function slideshow(){
                if (num == 3) {
                    num = 0;
                }
                else {
                    num ++;
                }
                document.getElementById("pic_ss").src=pics_src[num];
            }
            </script>
      <p>クリックで画像が変わります(計4枚)</p>
