<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!DOCTYPE html> 
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="ja" lang="ja">

<head>
	<meta charset="UTF-8" />
	<link rel="stylesheet" href="styles.css" />
	<title>VIPRPG 2021夏祭り</title>
</head>
<body id="main"><script type="text/javascript" charset="utf-8" src="//asumi.shinobi.jp/encount"></script><div style="text-align: center;"><div style="display: inline-block; position: relative; z-index: 9999;"><script type="text/javascript" charset="utf-8" src="//asumi.shinobi.jp/fire?f=435"></script><script type="text/javascript" charset="utf-8" src="/__sys__inactive_message.js"></script></div></div>


<table id="entry" class="color2">
<thead>
	<tr>
		<td class="entry_icon"><img src="/image/noicon.png" alt="アイコン画像" width="32" height="32" /></td>
        <!--png又はgif形式のアイコン(32px-32px)を入れる-->
		<th class="color1">題名</th>
        <!--↑題名を題名に書き換える-->
	</tr>
</thead>
<tbody>
	<tr>
		<td colspan="2"><img src="/image/no00ss1.png"  alt="SS画像" onmouseover="this.src='/image/no00ss2.png';" onmouseout="this.src='/image/no00ss1.png';" width="640" height="480" /></td>
	</tr>
    <!--↑src=""の所に初期表示画像、マウス載せた時の画像、マウス外した時の画像の順でss画像を入れる。-->
	<tr><td colspan="2" class="color2">作者：<!--作者名--></td></tr>
	<tr><td colspan="2" class="color3">ジャンル：<!--ジャンル--></td></tr>
	<tr><td colspan="2" class="color2">ツール：<!--2000など--></td></tr>
	<tr><td colspan="2" class="color3">配信/投稿：<!--○/○--></td></tr>
	<tr><td colspan="2" class="color2">作者コメント：<br />
<!--作者コメントをここに入力。改行は→<br />
-->ここに作者のコメントが入ります。</td></tr>
	<tr><td colspan="2" class="color3">管理人コメント：<br />
<!--管理人コメントをここに入力<br />-->
ここに管理人のコメントが入ります。</td></tr>
	<tr><td colspan="2" class="color2"><a href="https://ux.getuploader.com">ダウンロード(<!--ここに容量-->MB)</a>｜<a href="https://jbbs.shitaraba.net">感想掲示板</a></td></tr>
<!--↑ろだのURL、容量、掲示板のURLを書き変える。-->
    <tr><td colspan="2" class="color3"><a href="no00.html">前の作品</a>｜<a href="no01.html">次の作品</a>｜<a href="index.html">TOPへ戻る</a></td></tr>
<!--↑前の作品と次の作品のURLを書き変える。-->
</tbody>
</table>


