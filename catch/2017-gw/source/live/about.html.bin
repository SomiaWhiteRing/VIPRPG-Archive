<script>

var games = 50;

var tdy = new Date();
var month = tdy.getMonth()+1;
var day = tdy.getDate();

var rnd = 0;

rnd = month*999 + day*79 + 8;
if (rnd > 9999) {rnd -= month*500;}
rnd = rnd*rnd; rnd = rnd/100; rnd = Math.floor(rnd); rnd= rnd%10000; 
game_a = rnd % games + 1;

rnd = month*1002 + day*82 + 14;
if (rnd > 9999) {rnd -= month*500;}
rnd = rnd*rnd; rnd = rnd/100; rnd = Math.floor(rnd); rnd= rnd%10000;
game_b = rnd % games + 1;

if (game_a == game_b) {game_b = (game_a + 1) % games;}
if (game_a == 21) {game_a = (game_a + day) % games + 1}
if (game_b == 21) {game_b = (game_a + day + 4) % games + 1}


