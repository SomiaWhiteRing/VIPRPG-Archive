{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "postbuild": "tsx scripts/optimize-original-pages.ts",
    "start": "wrangler dev --local --port 3100",
    "deploy": "npm run build && wrangler deploy",
    "lint": "eslint src public/archive-browser.js scripts/validate-data.ts scripts/audit-archive.ts scripts/source-static-array.ts scripts/source-original-browser.ts scripts/optimize-original-pages.ts \"scripts/recover-*.ts\"",
    "lint:legacy": "eslint scripts",
    "audit:data": "tsx scripts/audit-archive.ts",
    "validate:data": "tsx scripts/validate-data.ts"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "iconv-lite": "^0.7.0",
    "next": "15.5.9",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "wrangler": "4.132.0"
  }
